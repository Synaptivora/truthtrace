# auto：填了 AI_API_KEY 就走真实模型，没填就走本地规则分析（按发言人/时间做确定性统计）。
# 其它取值：openai（强制模型）、rule（强制规则）、mock（只登记证据，不识别）
AI_PROVIDER=auto

# 使用 OpenAI 兼容的多模态模型时，改为 openai 并填写以下配置。
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini

# 可选：A 的独立证据解析服务。留空时使用应用内文本解析器。
# 一键配置（npm run setup 或界面按钮）会自动写入 http://127.0.0.1:8000
INGESTION_SERVICE_URL=

# ---- 微信直读（A 端 Python 进程读取，前端不直接用）----
# wechat-ai-memory 的 src 目录（需含 wechat_context_exporter/）。
# 不设时 A 端会探测 ~/wam_probe/src/wechat-ai-memory-main/src 等内置路径。
# SYNAPSE_WECHAT_SRC=
# 微信数据库密钥缓存位置；默认 %LOCALAPPDATA%\Synapse\wechat_db_keys.json
# SYNAPSE_WECHAT_KEY_CACHE=
# 设 0 可关闭「扫微信进程内存取图片密钥」，图片退回占位（更保守）
# SYNAPSE_WECHAT_IMAGE=1
# 指定 A 服务使用的 Python 解释器（默认 python / python3）
# SYNAPSE_PYTHON=
# 网络受限时，可指定 wechat-ai-memory 源码 zip 的下载地址（一键配置会优先用它）
# SYNAPSE_WAM_ZIP_URL=

# ---- 安装/配置开关 ----
# 设 1 可让 npm run dev:local 跳过「启动时自动装配工具」这一步
# SYNAPSE_SKIP_AUTO_SETUP=0
# 设 0 可彻底关闭 /api/setup（本机一键配置接口）
# SYNAPSE_SETUP_ENABLED=1

# 单次分析的容量闸门（模型路径生效）。文本类受字符预算保护，图片是另一笔账：
# 每张图都是一段 base64 请求体 + 一次视觉输入，所以张数与字节单独限额。
# 超限的部分不会静默丢弃，会在 /api/analyze 的 meta 里回传，界面顶部横幅明说。
# ANALYZE_MAX_EVIDENCE=200        # 单批总条数护栏（只挡病态输入）
# ANALYZE_MAX_IMAGES=20           # 最多送多少张图进模型
# ANALYZE_IMAGE_BUDGET_MB=64      # 图片总字节预算（本地运行，不经网关，可给得大方）
# ANALYZE_IMAGE_MAX_MB=8          # 单张上限，超了直接跳过
# ANALYZE_CHAR_BUDGET=200000      # 文本总字符预算，超出按条截断并注明「原文共多少字」
# AI_TIMEOUT_MS=180000            # 模型调用超时（证据变多后 90 秒不够用）

# 对话 Agent：未设置时沿用 AI_*；也可在网页模型设置中临时填写。
# AGENT_PROVIDER=deepseek
# AGENT_PROTOCOL=openai
# AGENT_BASE_URL=https://api.deepseek.com
# AGENT_MODEL=填写当前账号可用的模型 ID
# AGENT_API_KEY=
# AGENT_TOOLS=true
# 协议：openai（Chat Completions）、anthropic（Messages）、responses。
# Ollama：AGENT_PROVIDER=ollama，BASE_URL=http://127.0.0.1:11434/v1，Key 可留空。
